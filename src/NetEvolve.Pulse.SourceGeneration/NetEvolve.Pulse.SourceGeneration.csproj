<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>Roslyn source generator for the Pulse CQRS mediator library. Automatically generates DI registration code for handler classes annotated with [PulseHandler], eliminating manual service registrations and catching missing or duplicate registrations at compile time.</Description>
    <PackageTags>$(PackageTags);source-generation;roslyn;analyzer;</PackageTags>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <LangVersion>latest</LangVersion>
    <!-- Suppress warnings not applicable to source generators targeting netstandard2.0 -->
    <NoWarn>$(NoWarn);RS1035;RS1036;RS1038;RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="NetEvolve.CodeBuilder" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetEvolve.Pulse.SourceGeneration.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!-- The generator loads NetEvolve.CodeBuilder at compile time, so it must ship next to the generator assembly. -->
    <None Include="$(PkgNetEvolve_CodeBuilder)\lib\netstandard2.0\NetEvolve.CodeBuilder.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <!-- Flows NetEvolve.CodeBuilder to projects that reference the generator via ProjectReference with OutputItemType="Analyzer". -->
  <PropertyGroup>
    <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPaths</GetTargetPathDependsOn>
  </PropertyGroup>

  <Target Name="GetDependencyTargetPaths">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="$(PkgNetEvolve_CodeBuilder)\lib\netstandard2.0\NetEvolve.CodeBuilder.dll" IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="NetEvolve.Pulse.SourceGeneration.Tests.Unit" />
  </ItemGroup>
</Project>
